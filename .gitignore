# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated public site (its own repo for GitHub Pages)
/public-site

# private: the journal database, its backup, and editor config with API keys
/dev.db
/dev.backup.db
/dev.db-journal
.vscode/mcp.json
/demo.db

# entries deleted through Ask are backed up here before removal
/backups
/.next-test/
/.next-demo/
