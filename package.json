{
  "name": "full-note",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "dev:demo": "DATABASE_URL=file:./demo.db NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p 3001",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:schedule": "node scripts/backup-schedule.mjs",
    "backup:unschedule": "node scripts/backup-schedule.mjs --off",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:add": "node scripts/demo.mjs add",
    "demo:remove": "node scripts/demo.mjs remove",
    "release:template": "node scripts/release-template.mjs",
    "publish:build": "node scripts/build-public-site.mjs",
    "publish:push": "node scripts/publish-push.mjs",
    "publish:login": "node scripts/publish-push.mjs --login",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "mammoth": "^1.13.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
